{
  "name": "lin1chun-blog",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "description": "A long-form personal website built with Hugo and hugo-brewm.",
  "scripts": {
    "dev": "hugo server --environment development --renderToMemory --minify --gc -D --baseURL http://localhost:1313/",
    "build": "npm run build:site && npm run build:search",
    "build:site": "hugo --environment production --minify --gc --cleanDestinationDir",
    "build:search": "pagefind --site public",
    "verify": "npm run check && npm run build && npm run check:links",
    "check": "npm run test:days-since-birth && npm run test:links-page && npm run test:footer-layout && npm run check:js && npm run check:data && npm run check:repo && npm run check:site",
    "check:js": "node scripts/check-js.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:site": "hugo --environment production --minify --gc --renderToMemory",
    "check:links": "node scripts/check-internal-links.mjs",
    "test:footer-layout": "node --test scripts/test-footer-layout.mjs",
    "test:days-since-birth": "node --test scripts/test-days-since-birth.mjs",
    "test:links-page": "node --test scripts/test-links-page.mjs",
    "sync:neuro-feed": "node scripts/update-neuro-feed.mjs",
    "archive:cc98": "node scripts/archive-cc98-topic.mjs",
    "generate:zju-growth": "node scripts/generate-zju-growth.mjs"
  },
  "devDependencies": {
    "pagefind": "1.5.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "ubb-core": "1.0.0"
  }
}
