{
  "name": "lin1chun-blog",
  "version": "0.1.0",
  "private": true,
  "description": "A personal blog built with Hugo and hugo-brewm.",
  "scripts": {
    "dev": "hugo server --minify --gc -D",
    "build": "npm run build:site && npm run build:search",
    "build:site": "hugo --minify --gc --cleanDestinationDir",
    "build:search": "pagefind --site public",
    "check": "hugo --minify --gc --renderToMemory"
  },
  "devDependencies": {
    "pagefind": "1.5.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
